<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>نسخ كود Nuvopulse</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:system-ui,sans-serif;}
body{background:#0c0c18;color:#eef0ff;padding:18px;}
h2{font-size:18px;margin-bottom:6px;}
p{color:#9aa;font-size:13px;margin-bottom:14px;line-height:1.6;}
button{width:100%;padding:16px;border:none;border-radius:14px;font-size:17px;font-weight:800;
 background:linear-gradient(100deg,#00e0c6,#7b5cff);color:#06060c;cursor:pointer;margin-bottom:14px;}
button:active{transform:scale(.98);}
.ok{background:linear-gradient(100deg,#22c55e,#16a34a)!important;color:#fff!important;}
textarea{width:100%;height:300px;background:#06060c;color:#7b9;border:1px solid #333;
 border-radius:10px;padding:12px;font-family:monospace;font-size:11px;direction:ltr;}
.step{background:#161430;border-radius:10px;padding:12px 14px;margin-bottom:10px;font-size:14px;color:#cdd;}
.step b{color:#00e0c6;}
</style></head>
<body>
<h2>📋 كود صفحة Nuvopulse</h2>
<p>اضغط الزر لنسخ الكود كاملاً، ثم الصقه في GitHub (Create new file باسم index.html)</p>
<button id="cp" onclick="copyit()">📋 نسخ الكود كاملاً</button>
<div class="step"><b>1.</b> اضغط الزر فوق (سيتحوّل أخضر ✓)</div>
<div class="step"><b>2.</b> GitHub ← Add file ← Create new file</div>
<div class="step"><b>3.</b> الاسم: <b>index.html</b></div>
<div class="step"><b>4.</b> الصق في الصندوق ← Commit changes</div>
<textarea id="code" readonly>&lt;!DOCTYPE html&gt;
&lt;html lang=&quot;ar&quot; dir=&quot;rtl&quot;&gt;
&lt;head&gt;
&lt;meta charset=&quot;UTF-8&quot;&gt;
&lt;meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot;&gt;
&lt;title&gt;Nuvopulse&lt;/title&gt;
&lt;link rel=&quot;preconnect&quot; href=&quot;https://fonts.googleapis.com&quot;&gt;
&lt;link rel=&quot;preconnect&quot; href=&quot;https://fonts.gstatic.com&quot; crossorigin&gt;
&lt;link href=&quot;https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&amp;family=Vazirmatn:wght@400;600;700;900&amp;family=Space+Grotesk:wght@500;700&amp;display=swap&quot; rel=&quot;stylesheet&quot;&gt;
&lt;style&gt;
  :root{
    --bg:#06060c; --pulse:#00e0c6; --pulse2:#7b5cff; --hot:#ff4d8d;
    --paper:#eef0ff; --muted:rgba(238,240,255,.5);
    --card:rgba(255,255,255,.045); --stroke:rgba(255,255,255,.09);
  }
  *{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
  body{font-family:&#x27;Cairo&#x27;,sans-serif;color:var(--paper);background:var(--bg);min-height:100vh;
    display:flex;justify-content:center;align-items:flex-start;padding:24px 18px 60px;position:relative;overflow-x:hidden;}
  body[data-lang=&quot;fa&quot;]{font-family:&#x27;Vazirmatn&#x27;,sans-serif;}
  body[data-lang=&quot;en&quot;]{font-family:&#x27;Space Grotesk&#x27;,sans-serif;direction:ltr;}
  body::before{content:&quot;&quot;;position:fixed;inset:-30%;z-index:0;pointer-events:none;
    background:
      radial-gradient(420px 420px at 18% 8%, rgba(0,224,198,.20), transparent 60%),
      radial-gradient(460px 460px at 85% 18%, rgba(123,92,255,.22), transparent 60%),
      radial-gradient(500px 500px at 50% 105%, rgba(255,77,141,.16), transparent 60%);
    filter:blur(8px);animation:drift 14s ease-in-out infinite alternate;}
  .wrap{width:100%;max-width:440px;position:relative;z-index:1;}

  /* language switcher */
  .langbar{display:flex;gap:6px;justify-content:center;margin-bottom:18px;animation:rise .6s both;}
  .langbar button{
    background:var(--card);border:1px solid var(--stroke);color:var(--muted);
    border-radius:20px;padding:7px 16px;font-size:13px;font-weight:700;cursor:pointer;
    font-family:inherit;transition:all .15s;}
  .langbar button.active{background:linear-gradient(100deg,var(--pulse),var(--pulse2));color:#06060c;border-color:transparent;}

  .brand{display:flex;flex-direction:column;align-items:center;margin-bottom:6px;}
  .logo{display:flex;align-items:center;gap:10px;animation:rise .7s both;}
  .logo .dot{width:14px;height:14px;border-radius:50%;background:var(--pulse);
    box-shadow:0 0 0 0 rgba(0,224,198,.6);animation:beat 1.6s infinite;}
  .logo h1{font-family:&#x27;Space Grotesk&#x27;,sans-serif;font-weight:700;font-size:30px;letter-spacing:-.5px;
    background:linear-gradient(100deg,var(--pulse),var(--pulse2) 60%,var(--hot));
    -webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;}
  .heartbeat{width:200px;height:30px;margin:8px 0 2px;animation:rise .7s .1s both;}
  .heartbeat path{stroke:url(#pg);stroke-width:2.5;fill:none;stroke-dasharray:300;stroke-dashoffset:300;
    animation:trace 2.4s ease-in-out .4s forwards, glow 2.6s ease-in-out 2.8s infinite;}
  .tag{color:var(--paper);font-weight:700;font-size:15px;margin-top:6px;animation:rise .7s .16s both;}
  .by{color:var(--muted);font-size:12.5px;margin-top:3px;animation:rise .7s .22s both;}

  .feat{margin:24px 0 8px;display:block;text-decoration:none;color:var(--bg);border-radius:22px;padding:2px;
    position:relative;overflow:hidden;background:linear-gradient(120deg,var(--pulse),var(--pulse2),var(--hot));
    background-size:200% 200%;animation:rise .7s .26s both, flow 6s ease infinite;box-shadow:0 18px 44px rgba(123,92,255,.3);}
  .feat-in{background:#fff;border-radius:20px;padding:18px 20px;position:relative;overflow:hidden;}
  .feat-top{display:flex;align-items:center;gap:13px;position:relative;}
  .feat .em{font-size:30px;}
  .feat h2{font-size:18px;font-weight:900;color:#0a0a14;}
  .feat .d{font-size:12px;font-weight:600;color:#5a5a72;margin-top:2px;}
  .feat-cta{margin-top:14px;border-radius:13px;padding:12px;text-align:center;font-weight:900;font-size:15px;color:#fff;
    position:relative;background:linear-gradient(100deg,var(--pulse2),var(--hot));
    display:flex;align-items:center;justify-content:center;gap:8px;}
  .feat .small{font-size:11px;text-align:center;color:#7a7a92;margin-top:9px;font-weight:600;}
  .badge{position:absolute;top:13px;inset-inline-start:13px;background:#0a0a14;color:var(--pulse);
    font-size:10px;font-weight:800;padding:4px 9px;border-radius:20px;z-index:2;}

  .label{display:flex;align-items:center;gap:10px;margin:24px 4px 13px;color:var(--muted);
    font-weight:700;font-size:12px;animation:rise .7s .3s both;}
  .label::before,.label::after{content:&quot;&quot;;flex:1;height:1px;background:var(--stroke);}
  .link{display:flex;align-items:center;gap:14px;text-decoration:none;color:var(--paper);
    background:var(--card);border:1px solid var(--stroke);border-radius:16px;padding:14px 16px;margin-bottom:11px;
    backdrop-filter:blur(10px);transition:transform .16s,border-color .16s,background .16s;animation:rise .6s both;}
  .link:active{transform:scale(.98);}
  .ic{width:42px;height:42px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0;}
  .ig{background:linear-gradient(45deg,#f09433,#dc2743,#bc1888);}
  .x{background:#000;border:1px solid #2a2a2a;}
  .tg{background:#229ED9;}
  .link .t{font-weight:700;font-size:15px;}
  .link .h{font-size:12px;color:var(--muted);margin-top:1px;}
  .link .ar{margin-inline-start:auto;color:var(--muted);font-size:17px;}
  footer{text-align:center;margin-top:28px;color:var(--muted);font-size:12px;animation:rise .7s .6s both;}
  footer b{color:var(--paper);}

  @keyframes beat{0%,100%{box-shadow:0 0 0 0 rgba(0,224,198,.55);}50%{box-shadow:0 0 0 9px rgba(0,224,198,0);}}
  @keyframes trace{to{stroke-dashoffset:0;}}
  @keyframes glow{0%,100%{filter:drop-shadow(0 0 1px var(--pulse));}50%{filter:drop-shadow(0 0 6px var(--pulse));}}
  @keyframes rise{from{opacity:0;transform:translateY(18px);}to{opacity:1;transform:translateY(0);}}
  @keyframes drift{from{transform:translate(-2%,-1%) scale(1);}to{transform:translate(2%,1%) scale(1.08);}}
  @keyframes flow{0%,100%{background-position:0% 50%;}50%{background-position:100% 50%;}}
&lt;/style&gt;
&lt;/head&gt;
&lt;body data-lang=&quot;ar&quot;&gt;
  &lt;div class=&quot;wrap&quot;&gt;
    &lt;div class=&quot;langbar&quot;&gt;
      &lt;button data-set=&quot;ar&quot; class=&quot;active&quot; onclick=&quot;setLang(&#x27;ar&#x27;)&quot;&gt;عربي&lt;/button&gt;
      &lt;button data-set=&quot;en&quot; onclick=&quot;setLang(&#x27;en&#x27;)&quot;&gt;English&lt;/button&gt;
      &lt;button data-set=&quot;fa&quot; onclick=&quot;setLang(&#x27;fa&#x27;)&quot;&gt;فارسی&lt;/button&gt;
    &lt;/div&gt;

    &lt;div class=&quot;brand&quot;&gt;
      &lt;div class=&quot;logo&quot;&gt;&lt;span class=&quot;dot&quot;&gt;&lt;/span&gt;&lt;h1&gt;Nuvopulse&lt;/h1&gt;&lt;/div&gt;
      &lt;svg class=&quot;heartbeat&quot; viewBox=&quot;0 0 200 30&quot; fill=&quot;none&quot;&gt;
        &lt;defs&gt;&lt;linearGradient id=&quot;pg&quot; x1=&quot;0&quot; y1=&quot;0&quot; x2=&quot;200&quot; y2=&quot;0&quot;&gt;
          &lt;stop offset=&quot;0&quot; stop-color=&quot;#00e0c6&quot;/&gt;&lt;stop offset=&quot;.6&quot; stop-color=&quot;#7b5cff&quot;/&gt;&lt;stop offset=&quot;1&quot; stop-color=&quot;#ff4d8d&quot;/&gt;
        &lt;/linearGradient&gt;&lt;/defs&gt;
        &lt;path d=&quot;M0 15 H60 L70 15 L78 4 L88 26 L96 15 L104 15 L112 9 L120 21 L128 15 H200&quot;/&gt;
      &lt;/svg&gt;
      &lt;div class=&quot;tag&quot; data-i=&quot;tag&quot;&gt;&lt;/div&gt;
      &lt;div class=&quot;by&quot; data-i=&quot;by&quot;&gt;&lt;/div&gt;
    &lt;/div&gt;

    &lt;a class=&quot;feat&quot; href=&quot;webcal://cdn.jsdelivr.net/gh/MR-989/Worldcup2026@main/WorldCup2026%20AbdulmalikHouti.ics&quot;&gt;
      &lt;div class=&quot;feat-in&quot;&gt;
        &lt;span class=&quot;badge&quot; data-i=&quot;badge&quot;&gt;&lt;/span&gt;
        &lt;div class=&quot;feat-top&quot;&gt;
          &lt;span class=&quot;em&quot;&gt;🏆&lt;/span&gt;
          &lt;div&gt;
            &lt;h2 data-i=&quot;ftitle&quot;&gt;&lt;/h2&gt;
            &lt;div class=&quot;d&quot; data-i=&quot;fdesc&quot;&gt;&lt;/div&gt;
          &lt;/div&gt;
        &lt;/div&gt;
        &lt;div class=&quot;feat-cta&quot; data-i=&quot;fcta&quot;&gt;&lt;/div&gt;
        &lt;div class=&quot;small&quot; data-i=&quot;fsmall&quot;&gt;&lt;/div&gt;
      &lt;/div&gt;
    &lt;/a&gt;

    &lt;div class=&quot;label&quot; data-i=&quot;follow&quot;&gt;&lt;/div&gt;

    &lt;a class=&quot;link&quot; href=&quot;https://www.instagram.com/nuvopulse&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;
      &lt;span class=&quot;ic ig&quot;&gt;📷&lt;/span&gt;
      &lt;div&gt;&lt;div class=&quot;t&quot;&gt;Instagram&lt;/div&gt;&lt;div class=&quot;h&quot;&gt;@nuvopulse&lt;/div&gt;&lt;/div&gt;
      &lt;span class=&quot;ar&quot;&gt;↗&lt;/span&gt;
    &lt;/a&gt;
    &lt;a class=&quot;link&quot; href=&quot;https://x.com/nuvopulse&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;
      &lt;span class=&quot;ic x&quot;&gt;𝕏&lt;/span&gt;
      &lt;div&gt;&lt;div class=&quot;t&quot;&gt;X (Twitter)&lt;/div&gt;&lt;div class=&quot;h&quot;&gt;@nuvopulse&lt;/div&gt;&lt;/div&gt;
      &lt;span class=&quot;ar&quot;&gt;↗&lt;/span&gt;
    &lt;/a&gt;
    &lt;a class=&quot;link&quot; href=&quot;https://t.me/NuvoPulse&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;
      &lt;span class=&quot;ic tg&quot;&gt;✈&lt;/span&gt;
      &lt;div&gt;&lt;div class=&quot;t&quot;&gt;Telegram&lt;/div&gt;&lt;div class=&quot;h&quot;&gt;@NuvoPulse&lt;/div&gt;&lt;/div&gt;
      &lt;span class=&quot;ar&quot;&gt;↗&lt;/span&gt;
    &lt;/a&gt;

    &lt;footer&gt;© 2026 &lt;b&gt;Nuvopulse&lt;/b&gt; · &lt;span data-i=&quot;foot&quot;&gt;&lt;/span&gt;&lt;/footer&gt;
  &lt;/div&gt;

&lt;script&gt;
const I = {
  ar:{dir:&quot;rtl&quot;,tag:&quot;نبض كل جديد ⚡&quot;,by:&quot;بإشراف عبدالملك هوتي&quot;,badge:&quot;⭐ مميّز&quot;,
      ftitle:&quot;تقويم كأس العالم 2026&quot;,fdesc:&quot;104 مباريات تُضاف لجوالك تلقائياً + تنبيهات&quot;,
      fcta:&quot;＋ اشترك في التقويم الآن&quot;,fsmall:&quot;iPhone و Android · مجاناً · يحدّث نفسه&quot;,
      follow:&quot;تابع Nuvopulse&quot;,foot:&quot;نبض كل جديد&quot;},
  en:{dir:&quot;ltr&quot;,tag:&quot;The pulse of everything new ⚡&quot;,by:&quot;by Abdulmalik Houti&quot;,badge:&quot;⭐ Featured&quot;,
      ftitle:&quot;World Cup 2026 Calendar&quot;,fdesc:&quot;104 matches auto-added to your phone + reminders&quot;,
      fcta:&quot;＋ Subscribe to Calendar&quot;,fsmall:&quot;iPhone &amp; Android · Free · Auto-updates&quot;,
      follow:&quot;Follow Nuvopulse&quot;,foot:&quot;The pulse of everything new&quot;},
  fa:{dir:&quot;rtl&quot;,tag:&quot;نبض هر تازه ⚡&quot;,by:&quot;توسط عبدالملک هوتی&quot;,badge:&quot;⭐ ویژه&quot;,
      ftitle:&quot;تقویم جام جهانی ۲۰۲۶&quot;,fdesc:&quot;۱۰۴ بازی به‌طور خودکار به گوشی شما اضافه می‌شود + یادآوری&quot;,
      fcta:&quot;＋ اشتراک در تقویم&quot;,fsmall:&quot;iPhone و Android · رایگان · به‌روزرسانی خودکار&quot;,
      follow:&quot;دنبال کنید Nuvopulse&quot;,foot:&quot;نبض هر تازه&quot;}
};
function setLang(l){
  const t=I[l];
  document.body.setAttribute(&quot;data-lang&quot;,l);
  document.documentElement.lang=l;
  document.documentElement.dir=t.dir;
  document.querySelectorAll(&quot;[data-i]&quot;).forEach(el=&gt;{el.textContent=t[el.getAttribute(&quot;data-i&quot;)];});
  document.querySelectorAll(&quot;.langbar button&quot;).forEach(b=&gt;{
    b.classList.toggle(&quot;active&quot;, b.getAttribute(&quot;data-set&quot;)===l);
  });
}
setLang(&quot;ar&quot;);
&lt;/script&gt;
&lt;/body&gt;
&lt;/html&gt;
</textarea>
<script>
const CODE = "<!DOCTYPE html>\n<html lang=\"ar\" dir=\"rtl\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Nuvopulse</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&family=Vazirmatn:wght@400;600;700;900&family=Space+Grotesk:wght@500;700&display=swap\" rel=\"stylesheet\">\n<style>\n  :root{\n    --bg:#06060c; --pulse:#00e0c6; --pulse2:#7b5cff; --hot:#ff4d8d;\n    --paper:#eef0ff; --muted:rgba(238,240,255,.5);\n    --card:rgba(255,255,255,.045); --stroke:rgba(255,255,255,.09);\n  }\n  *{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent;}\n  body{font-family:'Cairo',sans-serif;color:var(--paper);background:var(--bg);min-height:100vh;\n    display:flex;justify-content:center;align-items:flex-start;padding:24px 18px 60px;position:relative;overflow-x:hidden;}\n  body[data-lang=\"fa\"]{font-family:'Vazirmatn',sans-serif;}\n  body[data-lang=\"en\"]{font-family:'Space Grotesk',sans-serif;direction:ltr;}\n  body::before{content:\"\";position:fixed;inset:-30%;z-index:0;pointer-events:none;\n    background:\n      radial-gradient(420px 420px at 18% 8%, rgba(0,224,198,.20), transparent 60%),\n      radial-gradient(460px 460px at 85% 18%, rgba(123,92,255,.22), transparent 60%),\n      radial-gradient(500px 500px at 50% 105%, rgba(255,77,141,.16), transparent 60%);\n    filter:blur(8px);animation:drift 14s ease-in-out infinite alternate;}\n  .wrap{width:100%;max-width:440px;position:relative;z-index:1;}\n\n  /* language switcher */\n  .langbar{display:flex;gap:6px;justify-content:center;margin-bottom:18px;animation:rise .6s both;}\n  .langbar button{\n    background:var(--card);border:1px solid var(--stroke);color:var(--muted);\n    border-radius:20px;padding:7px 16px;font-size:13px;font-weight:700;cursor:pointer;\n    font-family:inherit;transition:all .15s;}\n  .langbar button.active{background:linear-gradient(100deg,var(--pulse),var(--pulse2));color:#06060c;border-color:transparent;}\n\n  .brand{display:flex;flex-direction:column;align-items:center;margin-bottom:6px;}\n  .logo{display:flex;align-items:center;gap:10px;animation:rise .7s both;}\n  .logo .dot{width:14px;height:14px;border-radius:50%;background:var(--pulse);\n    box-shadow:0 0 0 0 rgba(0,224,198,.6);animation:beat 1.6s infinite;}\n  .logo h1{font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:30px;letter-spacing:-.5px;\n    background:linear-gradient(100deg,var(--pulse),var(--pulse2) 60%,var(--hot));\n    -webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;}\n  .heartbeat{width:200px;height:30px;margin:8px 0 2px;animation:rise .7s .1s both;}\n  .heartbeat path{stroke:url(#pg);stroke-width:2.5;fill:none;stroke-dasharray:300;stroke-dashoffset:300;\n    animation:trace 2.4s ease-in-out .4s forwards, glow 2.6s ease-in-out 2.8s infinite;}\n  .tag{color:var(--paper);font-weight:700;font-size:15px;margin-top:6px;animation:rise .7s .16s both;}\n  .by{color:var(--muted);font-size:12.5px;margin-top:3px;animation:rise .7s .22s both;}\n\n  .feat{margin:24px 0 8px;display:block;text-decoration:none;color:var(--bg);border-radius:22px;padding:2px;\n    position:relative;overflow:hidden;background:linear-gradient(120deg,var(--pulse),var(--pulse2),var(--hot));\n    background-size:200% 200%;animation:rise .7s .26s both, flow 6s ease infinite;box-shadow:0 18px 44px rgba(123,92,255,.3);}\n  .feat-in{background:#fff;border-radius:20px;padding:18px 20px;position:relative;overflow:hidden;}\n  .feat-top{display:flex;align-items:center;gap:13px;position:relative;}\n  .feat .em{font-size:30px;}\n  .feat h2{font-size:18px;font-weight:900;color:#0a0a14;}\n  .feat .d{font-size:12px;font-weight:600;color:#5a5a72;margin-top:2px;}\n  .feat-cta{margin-top:14px;border-radius:13px;padding:12px;text-align:center;font-weight:900;font-size:15px;color:#fff;\n    position:relative;background:linear-gradient(100deg,var(--pulse2),var(--hot));\n    display:flex;align-items:center;justify-content:center;gap:8px;}\n  .feat .small{font-size:11px;text-align:center;color:#7a7a92;margin-top:9px;font-weight:600;}\n  .badge{position:absolute;top:13px;inset-inline-start:13px;background:#0a0a14;color:var(--pulse);\n    font-size:10px;font-weight:800;padding:4px 9px;border-radius:20px;z-index:2;}\n\n  .label{display:flex;align-items:center;gap:10px;margin:24px 4px 13px;color:var(--muted);\n    font-weight:700;font-size:12px;animation:rise .7s .3s both;}\n  .label::before,.label::after{content:\"\";flex:1;height:1px;background:var(--stroke);}\n  .link{display:flex;align-items:center;gap:14px;text-decoration:none;color:var(--paper);\n    background:var(--card);border:1px solid var(--stroke);border-radius:16px;padding:14px 16px;margin-bottom:11px;\n    backdrop-filter:blur(10px);transition:transform .16s,border-color .16s,background .16s;animation:rise .6s both;}\n  .link:active{transform:scale(.98);}\n  .ic{width:42px;height:42px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0;}\n  .ig{background:linear-gradient(45deg,#f09433,#dc2743,#bc1888);}\n  .x{background:#000;border:1px solid #2a2a2a;}\n  .tg{background:#229ED9;}\n  .link .t{font-weight:700;font-size:15px;}\n  .link .h{font-size:12px;color:var(--muted);margin-top:1px;}\n  .link .ar{margin-inline-start:auto;color:var(--muted);font-size:17px;}\n  footer{text-align:center;margin-top:28px;color:var(--muted);font-size:12px;animation:rise .7s .6s both;}\n  footer b{color:var(--paper);}\n\n  @keyframes beat{0%,100%{box-shadow:0 0 0 0 rgba(0,224,198,.55);}50%{box-shadow:0 0 0 9px rgba(0,224,198,0);}}\n  @keyframes trace{to{stroke-dashoffset:0;}}\n  @keyframes glow{0%,100%{filter:drop-shadow(0 0 1px var(--pulse));}50%{filter:drop-shadow(0 0 6px var(--pulse));}}\n  @keyframes rise{from{opacity:0;transform:translateY(18px);}to{opacity:1;transform:translateY(0);}}\n  @keyframes drift{from{transform:translate(-2%,-1%) scale(1);}to{transform:translate(2%,1%) scale(1.08);}}\n  @keyframes flow{0%,100%{background-position:0% 50%;}50%{background-position:100% 50%;}}\n</style>\n</head>\n<body data-lang=\"ar\">\n  <div class=\"wrap\">\n    <div class=\"langbar\">\n      <button data-set=\"ar\" class=\"active\" onclick=\"setLang('ar')\">\u0639\u0631\u0628\u064a</button>\n      <button data-set=\"en\" onclick=\"setLang('en')\">English</button>\n      <button data-set=\"fa\" onclick=\"setLang('fa')\">\u0641\u0627\u0631\u0633\u06cc</button>\n    </div>\n\n    <div class=\"brand\">\n      <div class=\"logo\"><span class=\"dot\"></span><h1>Nuvopulse</h1></div>\n      <svg class=\"heartbeat\" viewBox=\"0 0 200 30\" fill=\"none\">\n        <defs><linearGradient id=\"pg\" x1=\"0\" y1=\"0\" x2=\"200\" y2=\"0\">\n          <stop offset=\"0\" stop-color=\"#00e0c6\"/><stop offset=\".6\" stop-color=\"#7b5cff\"/><stop offset=\"1\" stop-color=\"#ff4d8d\"/>\n        </linearGradient></defs>\n        <path d=\"M0 15 H60 L70 15 L78 4 L88 26 L96 15 L104 15 L112 9 L120 21 L128 15 H200\"/>\n      </svg>\n      <div class=\"tag\" data-i=\"tag\"></div>\n      <div class=\"by\" data-i=\"by\"></div>\n    </div>\n\n    <a class=\"feat\" href=\"webcal://cdn.jsdelivr.net/gh/MR-989/Worldcup2026@main/WorldCup2026%20AbdulmalikHouti.ics\">\n      <div class=\"feat-in\">\n        <span class=\"badge\" data-i=\"badge\"></span>\n        <div class=\"feat-top\">\n          <span class=\"em\">\ud83c\udfc6</span>\n          <div>\n            <h2 data-i=\"ftitle\"></h2>\n            <div class=\"d\" data-i=\"fdesc\"></div>\n          </div>\n        </div>\n        <div class=\"feat-cta\" data-i=\"fcta\"></div>\n        <div class=\"small\" data-i=\"fsmall\"></div>\n      </div>\n    </a>\n\n    <div class=\"label\" data-i=\"follow\"></div>\n\n    <a class=\"link\" href=\"https://www.instagram.com/nuvopulse\" target=\"_blank\" rel=\"noopener\">\n      <span class=\"ic ig\">\ud83d\udcf7</span>\n      <div><div class=\"t\">Instagram</div><div class=\"h\">@nuvopulse</div></div>\n      <span class=\"ar\">\u2197</span>\n    </a>\n    <a class=\"link\" href=\"https://x.com/nuvopulse\" target=\"_blank\" rel=\"noopener\">\n      <span class=\"ic x\">\ud835\udd4f</span>\n      <div><div class=\"t\">X (Twitter)</div><div class=\"h\">@nuvopulse</div></div>\n      <span class=\"ar\">\u2197</span>\n    </a>\n    <a class=\"link\" href=\"https://t.me/NuvoPulse\" target=\"_blank\" rel=\"noopener\">\n      <span class=\"ic tg\">\u2708</span>\n      <div><div class=\"t\">Telegram</div><div class=\"h\">@NuvoPulse</div></div>\n      <span class=\"ar\">\u2197</span>\n    </a>\n\n    <footer>\u00a9 2026 <b>Nuvopulse</b> \u00b7 <span data-i=\"foot\"></span></footer>\n  </div>\n\n<script>\nconst I = {\n  ar:{dir:\"rtl\",tag:\"\u0646\u0628\u0636 \u0643\u0644 \u062c\u062f\u064a\u062f \u26a1\",by:\"\u0628\u0625\u0634\u0631\u0627\u0641 \u0639\u0628\u062f\u0627\u0644\u0645\u0644\u0643 \u0647\u0648\u062a\u064a\",badge:\"\u2b50 \u0645\u0645\u064a\u0651\u0632\",\n      ftitle:\"\u062a\u0642\u0648\u064a\u0645 \u0643\u0623\u0633 \u0627\u0644\u0639\u0627\u0644\u0645 2026\",fdesc:\"104 \u0645\u0628\u0627\u0631\u064a\u0627\u062a \u062a\u064f\u0636\u0627\u0641 \u0644\u062c\u0648\u0627\u0644\u0643 \u062a\u0644\u0642\u0627\u0626\u064a\u0627\u064b + \u062a\u0646\u0628\u064a\u0647\u0627\u062a\",\n      fcta:\"\uff0b \u0627\u0634\u062a\u0631\u0643 \u0641\u064a \u0627\u0644\u062a\u0642\u0648\u064a\u0645 \u0627\u0644\u0622\u0646\",fsmall:\"iPhone \u0648 Android \u00b7 \u0645\u062c\u0627\u0646\u0627\u064b \u00b7 \u064a\u062d\u062f\u0651\u062b \u0646\u0641\u0633\u0647\",\n      follow:\"\u062a\u0627\u0628\u0639 Nuvopulse\",foot:\"\u0646\u0628\u0636 \u0643\u0644 \u062c\u062f\u064a\u062f\"},\n  en:{dir:\"ltr\",tag:\"The pulse of everything new \u26a1\",by:\"by Abdulmalik Houti\",badge:\"\u2b50 Featured\",\n      ftitle:\"World Cup 2026 Calendar\",fdesc:\"104 matches auto-added to your phone + reminders\",\n      fcta:\"\uff0b Subscribe to Calendar\",fsmall:\"iPhone & Android \u00b7 Free \u00b7 Auto-updates\",\n      follow:\"Follow Nuvopulse\",foot:\"The pulse of everything new\"},\n  fa:{dir:\"rtl\",tag:\"\u0646\u0628\u0636 \u0647\u0631 \u062a\u0627\u0632\u0647 \u26a1\",by:\"\u062a\u0648\u0633\u0637 \u0639\u0628\u062f\u0627\u0644\u0645\u0644\u06a9 \u0647\u0648\u062a\u06cc\",badge:\"\u2b50 \u0648\u06cc\u0698\u0647\",\n      ftitle:\"\u062a\u0642\u0648\u06cc\u0645 \u062c\u0627\u0645 \u062c\u0647\u0627\u0646\u06cc \u06f2\u06f0\u06f2\u06f6\",fdesc:\"\u06f1\u06f0\u06f4 \u0628\u0627\u0632\u06cc \u0628\u0647\u200c\u0637\u0648\u0631 \u062e\u0648\u062f\u06a9\u0627\u0631 \u0628\u0647 \u06af\u0648\u0634\u06cc \u0634\u0645\u0627 \u0627\u0636\u0627\u0641\u0647 \u0645\u06cc\u200c\u0634\u0648\u062f + \u06cc\u0627\u062f\u0622\u0648\u0631\u06cc\",\n      fcta:\"\uff0b \u0627\u0634\u062a\u0631\u0627\u06a9 \u062f\u0631 \u062a\u0642\u0648\u06cc\u0645\",fsmall:\"iPhone \u0648 Android \u00b7 \u0631\u0627\u06cc\u06af\u0627\u0646 \u00b7 \u0628\u0647\u200c\u0631\u0648\u0632\u0631\u0633\u0627\u0646\u06cc \u062e\u0648\u062f\u06a9\u0627\u0631\",\n      follow:\"\u062f\u0646\u0628\u0627\u0644 \u06a9\u0646\u06cc\u062f Nuvopulse\",foot:\"\u0646\u0628\u0636 \u0647\u0631 \u062a\u0627\u0632\u0647\"}\n};\nfunction setLang(l){\n  const t=I[l];\n  document.body.setAttribute(\"data-lang\",l);\n  document.documentElement.lang=l;\n  document.documentElement.dir=t.dir;\n  document.querySelectorAll(\"[data-i]\").forEach(el=>{el.textContent=t[el.getAttribute(\"data-i\")];});\n  document.querySelectorAll(\".langbar button\").forEach(b=>{\n    b.classList.toggle(\"active\", b.getAttribute(\"data-set\")===l);\n  });\n}\nsetLang(\"ar\");\n</script>\n</body>\n</html>\n";
function copyit(){
  const b=document.getElementById('cp');
  navigator.clipboard.writeText(CODE).then(()=>{
    b.textContent='✓ تم النسخ! الصقه في GitHub';b.classList.add('ok');
    setTimeout(()=>{b.textContent='📋 نسخ الكود كاملاً';b.classList.remove('ok');},2500);
  }).catch(()=>{
    const t=document.getElementById('code');t.focus();t.select();
    document.execCommand('copy');
    b.textContent='✓ تم النسخ!';b.classList.add('ok');
  });
}
</script>
</body></html>  
